#!name=F1 TV 节点维护
#!desc=F1 TV 播放探测、候选节点自动切换与状态面板（规则+脚本+面板）。策略组需按 README 在主配置粘贴两行——Surge 模块不能定义策略组。
#!date=2026-09-29

# Surge 模块不支持 [Proxy Group]：F1TV-US-Candidates 和 F1TV 两个策略组必须在主配置的
# [Proxy Group] 中定义（见 README 方式 A 第 1 步），否则下面的规则引用不到目标组。
# script-path 的脚本基址由 tools/render_config.py 填入：--url 指定远程地址，不带参数则填本机克隆路径。
# 对已渲染过的文件重复渲染是安全的，脚本基址会被重新指向。

[Rule]
# 模块规则插入到主配置规则之前，天然排在宽泛规则和 FINAL 前。
DOMAIN-SUFFIX,f1tv.formula1.com,F1TV
DOMAIN-SUFFIX,ott-video-cf.formula1.com,F1TV

[Script]
f1tv-probe-cron = type=cron,cronexp="0 */8 * * *",timeout=900,script-path=https://raw.githubusercontent.com/Tony1026/f1tv-surge/main/src/probe.js,argument="candidateGroup=F1TV-US-Candidates;f1tvGroup=F1TV;contentIds=1000010385;batchSize=0;intervalMs=800;timeoutSeconds=10;failTtlSeconds=36000;maxRuntimeSeconds=840;l3Enabled=false;notify=true"
f1tv-probe-manual = type=generic,timeout=900,script-path=https://raw.githubusercontent.com/Tony1026/f1tv-surge/main/src/probe.js,argument="candidateGroup=F1TV-US-Candidates;f1tvGroup=F1TV;contentIds=1000010385;batchSize=0;intervalMs=800;timeoutSeconds=10;failTtlSeconds=36000;maxRuntimeSeconds=840;l3Enabled=false;notify=true"
f1tv-select = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/Tony1026/f1tv-surge/main/src/select.js,argument="candidateGroup=F1TV-US-Candidates;f1tvGroup=F1TV"
f1tv-panel = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/Tony1026/f1tv-surge/main/src/panel.js,argument="f1tvGroup=F1TV;candidateGroup=F1TV-US-Candidates"

[Panel]
F1TVStatus = title="F1 TV 节点状态",content="请运行一次全量检测后刷新此面板",style=info,script-name=f1tv-panel,update-interval=60
